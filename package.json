{
  "name": "naming-lab",
  "version": "1.0.0",
  "private": true,
  "description": "A portable browser workshop for comparing and shortlisting name ideas.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/core.test.js",
    "start": "node scripts/serve.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19"
  }
}
